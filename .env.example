# MongoDB Atlas Real-time Database Connection
# Replace with your actual MongoDB Atlas connection string from cloud.mongodb.com
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/quiz_battle?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiz_battle?retryWrites=true&w=majority"

# Server Port
PORT=3000

# GEMINI_API_KEY: Optional for AI quiz generation features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"
